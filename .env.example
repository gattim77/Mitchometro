# Runtime values: configure these as Worker bindings/secrets when deploying.
# DB is a Cloudflare D1 binding, not a connection string.
MASTER_USER_EMAIL=
# Google OAuth web client. Redirect URI:
# https://mitchometro.third-ai.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encryption key for admin TOTP data (keep the real value private).
SPOTIFY_TOKEN_KEY=
# Optional admin invitation emails.
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
