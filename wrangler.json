{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mitchometro",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "vars": {
    "MASTER_USER_EMAIL": "gattim@gmail.com"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mitchometro",
      "database_id": "36a2e0ed-e14f-40f8-8283-3c0208ae2601",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "mitchometro.third-ai.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
